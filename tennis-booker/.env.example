# Tennis Club Credentials
CLUB_URL=https://clubspark.lta.org.uk/YourClubName/Booking
CLUB_LOGIN_URL=https://clubspark.lta.org.uk/YourClubName/Booking/BookByDate
USERNAME=your_email@example.com
PASSWORD=your_password

# Booking Preferences
# Day of week: monday, tuesday, wednesday, thursday, friday, saturday, sunday
PREFERRED_DAY=saturday
# Comma-separated preferred times in 24h format, tried in order
PREFERRED_TIMES=18:00,19:00,17:00,20:00
# Preferred court numbers (comma-separated, tried in order). Leave empty for any court.
PREFERRED_COURTS=1,2,3
# Duration in minutes (30, 60, 90, 120)
DURATION_MINUTES=60

# Booking Platform: clubspark | bookcourt_lta | generic
PLATFORM=clubspark

# Scheduling
# How many days in advance courts are released (typically 14)
DAYS_IN_ADVANCE=14
# Timezone for midnight trigger
TIMEZONE=Europe/London

# Notifications (optional)
# Set up a webhook URL to get notified (e.g., Slack, Discord, or ntfy.sh)
NOTIFICATION_WEBHOOK_URL=
# ntfy topic (if using ntfy.sh for push notifications)
NTFY_TOPIC=
